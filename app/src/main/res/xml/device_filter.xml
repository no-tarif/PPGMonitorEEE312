<?xml version="1.0" encoding="utf-8"?>
<!--
  Common USB-UART bridge chips found on ESP32 dev boards, plus native
  ESP32-S2/S3/C3 USB-CDC. All IDs are decimal (Android's device-filter
  format), converted from the hex VID/PID pairs vendors publish.
  UsbSerialSensorSource itself uses usb-serial-for-android's generic
  UsbSerialProber (not this file) to pick a driver - this filter only
  controls when Android treats a plugged-in device as "for this app"
  for the USB_DEVICE_ATTACHED intent in AndroidManifest.xml.
-->
<resources>
    <!-- Silicon Labs CP2102 / CP2104 - vendor 0x10C4, product 0xEA60 -->
    <usb-device vendor-id="4292" product-id="60000" />

    <!-- WCH CH340 - vendor 0x1A86, product 0x7523 -->
    <usb-device vendor-id="6790" product-id="29987" />

    <!-- WCH CH9102 (newer ESP32-C3/S3 boards) - vendor 0x1A86, product 0x55D4 -->
    <usb-device vendor-id="6790" product-id="21972" />

    <!-- FTDI FT232R - vendor 0x0403, product 0x6001 -->
    <usb-device vendor-id="1027" product-id="24577" />

    <!-- FTDI FT232H - vendor 0x0403, product 0x6014 -->
    <usb-device vendor-id="1027" product-id="24596" />

    <!-- Espressif native USB-CDC (ESP32-S2/S3/C3) - vendor 0x303A, any
         product ID: Espressif uses several PIDs across chip variants
         and modes (e.g. 0x1001 for the USB-JTAG/serial debug unit), so
         match the vendor alone rather than guessing one PID. -->
    <usb-device vendor-id="12346" />
</resources>
