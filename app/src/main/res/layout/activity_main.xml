<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-- BPM"
        android:textSize="56sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvRefHr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSqi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signal quality: --"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSpo2Live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SpO2 —"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvSpo2Detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <com.eee312.ppgmonitor.ui.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/rgSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/rbSimulated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulated"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbDataset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dataset" />

        <RadioButton
            android:id="@+id/rbUsb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32 (USB)" />

        <RadioButton
            android:id="@+id/rbBle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32 (BLE)" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/datasetOptionsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/spDataset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playback speed:"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rb1x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb2x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2x"
                android:layout_marginStart="16dp" />

            <RadioButton
                android:id="@+id/rb4x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4x"
                android:layout_marginStart="16dp" />

            <RadioButton
                android:id="@+id/rbFast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbLoop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loop" />

    </LinearLayout>

    <Button
        android:id="@+id/btnStartStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Idle"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="History" />

</LinearLayout>
</ScrollView>
