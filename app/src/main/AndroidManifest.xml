<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pre-Android 12 (API < 31): classic Bluetooth + location permissions.
         Location is required by the OS for BLE scanning on these versions
         even though this app never reads GPS. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Android 12+ (API 31+): the new split BLE permissions.
         neverForLocation tells the OS this app's scanning is not being
         used to derive location, which is true here. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Two ESP32 sensor link options: wired USB serial (phone as USB
         host - see USB_SERIAL_CONTRACT.md) or BLE (see BLE_CONTRACT.md).
         Both are reachable from the source selector; only USB has been
         tried against real hardware so far - see BleSensorSource.kt's
         header comment. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PPGMonitor">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PPGMonitor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets Android bring this activity to the front when a
                 matching ESP32 USB-serial adapter is plugged in, instead
                 of only the generic "app can't handle USB device"
                 behavior. singleTop above keeps this from spawning a
                 second MainActivity (and losing an in-progress session)
                 if the app is already open when that happens. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".history.HistoryActivity"
            android:exported="false"
            android:label="History"
            android:theme="@style/Theme.PPGMonitor" />

        <activity
            android:name=".history.HistoryDetailActivity"
            android:exported="false"
            android:label="Reading"
            android:theme="@style/Theme.PPGMonitor" />
    </application>

</manifest>